# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

PORT=5000

# ── Database ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=uhcs

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=<a long random string>

# ── Cloudinary (file storage) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# ── Frontend URL (used in email links, e.g. password reset) ─
FRONTEND_URL=http://localhost:5173

# ── Email — configure ONE of these (checked in this order) ──
# 1) Brevo HTTP API  (RECOMMENDED for Render — port 443, never blocked,
#    free 300/day, sends to anyone once you verify ONE sender email —
#    no domain DNS needed). Get the key at Brevo → SMTP & API → API Keys.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# EMAIL_FROM=Unified Health Care System <your-verified-sender@gmail.com>

# 2) Resend HTTP API  (port 443; free tier without a verified domain can
#    only email the Resend account owner)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Unified Health Care System <onboarding@resend.dev>

# 3) Generic SMTP provider (Brevo / SendGrid / Mailgun SMTP relay)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<provider login>
# SMTP_PASS=<provider smtp key>
# EMAIL_FROM=Unified Health Care System <your-verified-sender@example.com>

# 4) Gmail SMTP (works locally ONLY; Gmail blocks this from Render / datacenters)
EMAIL_USER=<your gmail address>
EMAIL_PASS=<gmail App Password, 16 chars, no spaces>
